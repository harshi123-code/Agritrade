# Add these variables in Render > your backend service > Environment.
# Use the private hostname of your MySQL service on Render.
SPRING_DATASOURCE_URL=jdbc:mysql://<mysql-service-host>:3306/agritrade?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=<mysql-root-password>

# Generate a private Base64 key with: openssl rand -base64 32
APP_JWT_SECRET=<replace-with-generated-base64-secret>

# Use the exact deployed Vercel origin, without a trailing slash.
APP_CORS_ALLOWED_ORIGINS=https://<your-vercel-project>.vercel.app

# Configure a hosted OpenAI-compatible provider for AgriAI.
APP_AI_API_KEY=<provider-api-key>
APP_AI_MODEL=<provider-model-name>
APP_AI_BASE_URL=https://<provider-api-host>/v1

# Render supplies PORT automatically. The app reads it and defaults to 8080 locally.
# Optional: set this only if you use MongoDB health checks.
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<database>
