# Local backend settings. Keep real credentials in backend/.env (never commit it).
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/agritrade?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-your-local-mysql-root-password
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
