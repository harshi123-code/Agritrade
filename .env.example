# Copy to .env for local Docker development. Never commit your real API key.
MYSQL_ROOT_PASSWORD=replace-with-your-local-mysql-root-password
DB_USERNAME=root
MYSQL_HOST_PORT=3307
FRONTEND_PORT=5173

# Create a key in Google AI Studio and keep it private in this backend environment.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
